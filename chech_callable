class DRYPermissionsField(fields.Field):
    """Добавление поля с permissions."""
    
    @ukatsiukevich
    def __init__(self, **kwargs):
        kwargs['read_only'] = True  # для исключения валидации
        super().__init__(**kwargs)

    def get_attribute(self, instance):
        """Возвращает сам объект, чтобы использовать его в to_representation."""
        return instance

    def _is_callable_method(self, obj, method_name):
        """Проверяет, существует ли метод и является ли он вызываемым."""
        return getattr(obj, method_name, None) and callable(getattr(obj, method_name))

    def to_representation(self, obj):
        """Права доступа в представление."""
        request = self.context.get('request')
        if not request or not getattr(request, 'user', None):
            return {}

        # Получаем модель
        if getattr(self.parent, 'Meta', None) and getattr(self.parent.Meta, 'model', None):
            model = self.parent.Meta.model
        elif obj:
            model = type(obj)
        else:
            return {}

        permissions = {}

        # Только основные permissions
        basic_permissions = ['read', 'write']

        for perm_name in basic_permissions:
            global_method = f'has_{perm_name}_permission'
            object_method = f'has_object_{perm_name}_permission'

            has_perm = False

            # Глобальная проверка
            if self._is_callable_method(model, global_method):
                has_perm = getattr(model, global_method)(request)

            # Object проверка
            if obj and has_perm:
                if self._is_callable_method(obj, object_method):
                    has_perm = getattr(obj, object_method)(request)
                elif self._is_callable_method(model, object_method):
                    has_perm = getattr(model, object_method)(request, obj)
                else:
                    permissions[perm_name] = has_perm
        return permissions
