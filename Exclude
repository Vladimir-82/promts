from rest_framework import serializers

class MyModelSerializer(serializers.ModelSerializer):
    class Meta:
        model = MyModel
        fields = '__all__'
    
    def get_unique_together_validators(self):
        # Переопределяем валидаторы уникальности
        validators = super().get_unique_together_validators()
        
        # Модифицируем существующие валидаторы
        for validator in validators:
            if hasattr(validator, 'exclude_current_instance'):
                # Подменяем метод
                validator.exclude_current_instance = self.custom_exclude_current_instance
        return validators
    
    def custom_exclude_current_instance(self, attrs, queryset, instance):
        # Ваша кастомная логика
        if instance is not None and hasattr(instance, 'pk'):
            return queryset.exclude(pk=instance.pk)
        return queryset
