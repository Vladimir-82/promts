class BanksSerializer(serializers.ModelSerializer):
    """Финансовые институты."""
    
    country_name = serializers.CharField(source='country.name', read_only=True)
    reporting_period_name = serializers.CharField(allow_null=True, read_only=True)
    reporting_period = serializers.IntegerField(source='reporting_period_value', allow_null=False)
    significant = serializers.IntegerField(source='significant_value', allow_null=True, read_only=True)
    
    class Meta:
        model = Bank
        fields = '__all__'  # Исправлено с '_all_' на '__all__'
    
    def validate_base_number(self, value):
        """Валидация уникальности base_number при обновлении."""
        if self.instance:  # Это обновление
            if value != self.instance.base_number:
                if Bank.objects.filter(base_number=value).exclude(id=self.instance.id).exists():
                    raise serializers.ValidationError("Базовый номер уже используется другим банком")
        else:  # Это создание
            if Bank.objects.filter(base_number=value).exists():
                raise serializers.ValidationError("Базовый номер уже существует")
        return value
    
    def validate_unp(self, value):
        """Валидация уникальности УНП при обновлении."""
        if value:  # Если УНП не пустой
            if self.instance:  # Это обновление
                if value != self.instance.unp:
                    if Bank.objects.filter(unp=value).exclude(id=self.instance.id).exists():
                        raise serializers.ValidationError("УНП уже используется другим банком")
            else:  # Это создание
                if Bank.objects.filter(unp=value).exists():
                    raise serializers.ValidationError("УНП уже существует")
        return value
