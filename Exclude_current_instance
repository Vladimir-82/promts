class ExcludeCurrentInstanceMixin:
    def exclude_current_instance(self, attrs, queryset, instance):
        # Ваша кастомная логика
        print(f"Custom exclude called with instance: {instance}")
        
        if instance is not None:
            # Добавляем проверку наличия pk
            if hasattr(instance, 'pk') and instance.pk:
                return queryset.exclude(pk=instance.pk)
        return queryset

# Использование в ModelForm
class MyModelForm(ExcludeCurrentInstanceMixin, ModelForm):
    class Meta:
        model = MyModel
        fields = '__all__'

# Использование в DRF сериализаторе
class MyModelSerializer(ExcludeCurrentInstanceMixin, serializers.ModelSerializer):
    class Meta:
        model = MyModel
        fields = '__all__'
