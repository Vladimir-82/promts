#!/usr/bin/env python3
"""
Быстрый поиск по Django проекту
"""

import os
import sys
from pathlib import Path

def quick_search(term):
    """Быстрый поиск по файлам"""
    
    root = Path.cwd()
    print(f"\n🔍 Поиск '{term}' в {root}\n")
    
    found = False
    
    for root, dirs, files in os.walk(root):
        # Исключаем ненужные директории
        dirs[:] = [d for d in dirs if d not in {'.venv', 'venv', '__pycache__', 'migrations'}]
        
        for file in files:
            if file.endswith(('.py', '.html', '.js')):
                file_path = Path(root) / file
                
                try:
                    with open(file_path, 'r', encoding='utf-8') as f:
                        lines = f.readlines()
                        
                    for i, line in enumerate(lines, 1):
                        if term in line:
                            rel_path = file_path.relative_to(Path.cwd())
                            print(f"📄 {rel_path}:{i}")
                            print(f"   {line.strip()}")
                            print()
                            found = True
                            
                except (UnicodeDecodeError, PermissionError):
                    continue
    
    if not found:
        print("❌ Ничего не найдено")

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Использование: python search.py <термин>")
        sys.exit(1)
    
    quick_search(sys.argv[1])
