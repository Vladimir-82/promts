        """Получение информации `О движении денежных средств`."""
        criteria = {
            '20': 'Поступило денежных средств - всего',
            '21': 'от покупателей продукции, товаров, заказчиков работ, услуг',
            '22': 'от покупателей материалов и других запасов',
            '23': 'роялти',
            '24': 'прочие поступления',
            '30': 'Направлено денежных средств – всего',
            '31': 'на приобретение запасов, работ, услуг',
            '32': 'на оплату труда',
            '33': 'на уплату налогов и сборов',
            '34': 'на прочие выплаты',
            '40': 'Результат движения денежных средств по текущей деятельности',
            '50': 'Поступило денежных средств – всего',
            '51': 'от покупателей основных средств, нематериальных активов и других долгосрочных активов',
            '52': 'возврат предоставленных займов',
            '53': 'доходы от участия в уставном капитале других организаций',
            '54': 'проценты',
            '55': 'прочие поступления',
            '60': 'Направлено денежных средств – всего',
            '61': 'на приобретение и создание основных средств, нематериальных активов и других долгосрочных активов',
            '62': 'на предоставление займов',
            '63': 'на вклады в уставный капитал других организаций',
            '64': 'прочие выплаты',
            '70': 'Результат движения денежных средств по инвестиционной деятельности ',
            '80': 'Поступило денежных средств – всего',
            '81': 'кредиты и займы',
            '82': 'от выпуска акций',
            '83': 'вклады собственника имущества (учредителей, участников)',
            '84': 'прочие поступления',
            '90': 'Направлено денежных средств – всего',
            '91': 'на погашение кредитов и займов',
            '92': 'на выплаты дивидендов и других доходов от участия в уставном капитале организации',
            '93': 'на выплаты процентов',
            '94': 'на лизинговые платежи',
            '95': 'прочие выплаты',
            '100': 'Результат движения денежных средств по финансовой деятельности',
            '110': 'Результат движения денежных средств по текущей, инвестиционной и финансовой деятельности',
            '120': 'Остаток денежных средств и эквивалентов денежных средств на __ г.',
            '130': 'Остаток денежных средств и эквивалентов денежных средств на ___ 20__ г.',
            '140': 'Влияние изменений курса иностранных валют',
        }
        return [
            (unp, self.ODDS, code, criteria_name, '', '')
            for code, criteria_name in criteria.items()
        ]

    def _get_additional_data(self, balance_date1, balance_date2, unp):
        """Получение дополнительной информации."""
        additional_data = [
            (unp, self.ADD, '901', 'EBITDA', self._get_ebitda(balance_date2), self._get_ebitda(balance_date1)),
            (unp, self.ADD, '902', 'амортизация', self._get_amortisation(balance_date2), self._get_amortisation(balance_date1)),
        ]
        criteria = {
            '903': 'погашение кредитов и займов',
            '903.1': 'основной долг',
            '903.2': 'проценты',
            '904': 'средневзвешенный срок кредита',
            '905': 'Условно-постоянные расходы за отчетный период',
            '906': 'Условно-переменные расходы за отчетный период',
        }
        additional_data.extend(
            (unp, self.ADD, code, criteria_name, '', '')
            for code, criteria_name in criteria.items()
        )
        return additional_data

    def _get_ebitda(self, balance: Balance):
        """Получение ebitda."""
        if balance:
            return balance.p090 + balance.pEbitCorrection + balance.pAmortisation
        return self.ND

    def _get_amortisation(self, balance: Balance):
        """Получение амортизации."""
        return getattr(balance, 'pAmortisation', self.ND)

    @staticmethod
    def _get_balances(client_ids, date):
        """Получение балансов."""
        return (
            Balance.objects
            .filter(client_id__in=client_ids, date=date)
            .order_by('client_id')
            .distinct('client_id')
            .in_bulk(field_name='client_id')
        )

    def _sheet_settings(self, worksheet) -> None:
        """Настройки для листов."""
        self._set_columns_width(worksheet)
        worksheet.set_zoom(100)
        worksheet.set_paper(9)  # Лист A4
        worksheet.set_landscape()
        worksheet.fit_to_pages(1, 1)
        worksheet.freeze_panes(1, 0)

    def _generate_file_name(self, client_name: str) -> str:
        """Получение имени файла."""
        client_name = self._clean_name(client_name)
        return f'{client_name}.xlsx'

    @staticmethod
    def _clean_name(client_name: str):
        """Очистка имени от нежелательных символов."""
        return client_name.replace('"', '').replace('«', '').replace('»', '')


    @staticmethod
    def _set_columns_width(worksheet):
        """Установка ширины столбцов."""
        columns_width = {
            'A:F': 15,
            'B:B': 20,
            'C:C': 10,
            'D:D': 40,
        }
        for col_name, width in columns_width.items():
            worksheet.set_column(col_name, width)
