"""Выгрузка информации по ТОП 50 клиентов. (FAUL-1690)

При вызове 'create' необходимо задать путь до Excel файла с ТОП 50 клиентов.
Базовые номера клиентов должны находится в столбце 'B' файла.

Данные для отчета берутся из балансов клиентов.
Данные по показателю EBITDA берутся в годовом выражении из сведений, формируемых в ПО ФАЮЛ во вкладке отчет.
"""

from pathlib import Path

import pandas as pd

from apps.clients.models.models import Client
from apps.finances.models.balances import Balance
from apps.utils import (
    Format,
    add_table,
)
from apps.utils.datetime import date_to_str
from apps.utils.file import create_dir_if_not_exists


class Top50Report:
    """Выгрузка информации по ТОП 50 клиентов."""

    ND = 'н/д'
    BALANCE = 'баланс'
    OPU = 'ОПУ'
    ODDS = 'ОДДС'
    ADD = 'Дополнительная информация'

    def __init__(self, date1, date2) -> None:
        self.date1 = date1
        self.date2 = date2
        self.path = Path('static', 'reports', 'balances', 'top50')
        create_dir_if_not_exists(self.path)

        exclude_fields = {
            'client', 'consolidation_clients', 'date', 'b560credit', 'pAmortisation', 'pEbitCorrection',
            'pPercentsCorrection', 'pCapitalCorrection', 'pCapitalOwnLoansLongCorrection', 'bDeveloperIncome',
            'b180FX', 'b230FX', 'b540FX', 'b650FX', 'pBonusReceived', 'pBonusPayed', 'bOwnLoansLong',
            'bOwnLoansShort', 'pExportShare', 'pImportShare', 'leasing_portfolio', 'debt', 'short_debt',
            'long_debt', 'long_liabilities', 'block_reason', 'history', 'id', 'created', 'modified',
        }
        self.field_names = [
            (f.name, f.verbose_name.lstrip('- '))
            for f in Balance._meta.get_fields()
            if f.name not in exclude_fields
            and getattr(f, 'verbose_name', None)
        ]
        self.report_types = {
            'b': self.BALANCE,
            'p': self.OPU,
        }

    def create(self, file_path: str):
        """Формирование отчетов по ТОП 50 клиентов."""
        with pd.ExcelFile(file_path) as excel_file:
            df = pd.read_excel(excel_file, sheet_name=0, usecols='B', dtype=str, names=['base_number'])  # Базовые номера в столбце B файла
            base_numbers = df['base_number'].tolist()
            clients = Client.objects.filter(base_number__in=base_numbers).only('id', 'unp', 'name').in_bulk(field_name='id')
            balances_date1 = self._get_balances(clients, self.date1)
            balances_date2 = self._get_balances(clients, self.date2)
            for client_id, client in clients.items():
                balance_date1 = balances_date1.get(client_id)
                balance_date2 = balances_date2.get(client_id)
                self.create_client_report(client, balance_date1, balance_date2)

    def create_client_report(self, client, balance_date1, balance_date2):
        """Формирование отчета по заданному клиенту."""
        file_name = self._generate_file_name(client.name)
        excel_file = self.path / file_name
        with pd.ExcelWriter(excel_file, engine='xlsxwriter') as writer:
            format_ = Format(writer.book, header_color='#b02421', header_font_color='#fcfafa')
            self._get_sheet(writer, format_, client, balance_date1, balance_date2)

    def _get_sheet(self, writer, format_: Format, client, balance_date1, balance_date2) -> None:
        """Формирование листа файла."""
        worksheet = writer.book.add_worksheet()
        self._sheet_settings(worksheet)
        table = self._create_table(client, balance_date1, balance_date2)

        columns_options = [
            {'header': 'УНП', 'header_format': format_.header, 'format': format_.left},
            {'header': 'Форма отчетности', 'header_format': format_.header, 'format': format_.center},
            {'header': 'Символ', 'header_format': format_.header, 'format': format_.center},
            {'header': 'Показатель', 'header_format': format_.header, 'format': format_.left},
            {'header': f'{date_to_str(self.date2)}', 'header_format': format_.header, 'format': format_.num},
            {'header': f'{date_to_str(self.date1)}', 'header_format': format_.header, 'format': format_.num},
        ]
        add_table(
            table,
            worksheet,
            row=0,
            col=0,
            options={'header_row': True, 'banded_rows': True},
            columns_options=columns_options,
        )

    def _create_table(self, client, balance_date1, balance_date2) -> pd.DataFrame:
        """Создание таблицы с данными."""
        report_data = self._get_report_data(client, balance_date1, balance_date2)
        return pd.DataFrame(report_data)

    def _get_report_data(self, client, balance_date1, balance_date2) -> list[tuple]:
        """Получение информации по отчету."""

        report_data = self._get_balance_data(balance_date1, balance_date2, client.unp)
        report_data.extend(self._get_rest_balance_data(client.unp))
        report_data.extend(self._get_odds_data(client.unp))
        report_data.extend(self._get_additional_data(balance_date1, balance_date2, client.unp))
        return report_data

    def _get_balance_data(self, balance_date1, balance_date2, unp):
        """Получение информации по балансам."""
        balance_data = []
        for name, verbose_name in self.field_names:
            prefix, code = name[0], name[1:]
            balance_data.append(
                (
                    unp,
                    self.report_types[prefix],
                    code,
                    verbose_name,
                    getattr(balance_date2, name, self.ND),
                    getattr(balance_date1, name, self.ND),
                ),
            )
        return balance_data

    def _get_rest_balance_data(self, unp):
        """Получение информации по балансам полей которых нет в ФАЮЛ."""
        criteria = {
            '220': 'Результат от переоценки долгосрочных активов, не включаемый в чистую прибыль (убыток)',
            '230': 'Результат от прочих операций, не включаемый в чистую прибыль (убыток)',
            '240': 'Совокупная прибыль (убыток)',
            '250': 'Базовая прибыль (убыток) на акцию',
            '260': 'Разводненная прибыль (убыток) на акцию',
        }
        return [
            (unp, self.OPU, code, criteria_name, '', '')  # Возможно правильнее указывать 'н/д'
            for code, criteria_name in criteria.items()
        ]

