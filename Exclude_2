from rest_framework import serializers
from django.core.exceptions import ValidationError

class BulkUpdateModelSerializer(serializers.ModelSerializer):
    """Сериализатор для массового обновления с корректной валидацией"""
    
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        
        # Если это bulk update, модифицируем валидаторы
        if self.context.get('bulk_update') and self.instance is not None:
            self._patch_unique_validators()
    
    def _patch_unique_validators(self):
        """Заменяем стандартные валидаторы уникальности на безопасные для bulk"""
        for field_name, field in self.fields.items():
            new_validators = []
            for validator in field.validators:
                if hasattr(validator, 'exclude_current_instance'):
                    # Создаем обертку для валидатора уникальности
                    validator = self._wrap_unique_validator(validator)
                new_validators.append(validator)
            field.validators = new_validators
    
    def _wrap_unique_validator(self, validator):
        """Создает обертку для валидатора уникальности, безопасную для bulk"""
        original_exclude = validator.exclude_current_instance
        
        def safe_exclude_current_instance(attrs, queryset, instance):
            # Безопасная версия exclude_current_instance для bulk операций
            if instance is None:
                return queryset
            
            # Если instance - это QuerySet (при many=True)
            if hasattr(instance, '__iter__') and not hasattr(instance, '_meta'):
                # Для массового обновления возвращаем исходный queryset
                # Валидация уникальности будет проверена на уровне БД
                return queryset
            
            # Если это обычная модель
            if hasattr(instance, 'pk'):
                return queryset.exclude(pk=instance.pk)
            
            return queryset
        
        # Подменяем метод
        validator.exclude_current_instance = safe_exclude_current_instance
        return validator
    
    def validate(self, attrs):
        """Переопределяем валидацию для bulk операций"""
        if self.context.get('bulk_update') and self.instance is not None:
            # При bulk update пропускаем некоторые проверки
            return attrs
        return super().validate(attrs)





