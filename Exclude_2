    def handle_integrity_error(self, err):
        """Обработка ошибок целостности БД"""
        error_str = str(err)
        date_match = re.search(r'\d{4}-\d{2}-\d{2}', error_str)
        
        if date_match:
            date = '.'.join(date_match.group(0).split('-')[:-1])
            return Response(
                f'На дату {date} уже есть баланс!', 
                status=status.HTTP_400_BAD_REQUEST
            )
        
        return Response(
            f'Ошибка базы данных: {error_str}', 
