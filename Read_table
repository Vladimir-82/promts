def read_table(self, table_name, rules_fields: dict,
    filter_fields, unique_fields: list | None = None) -> pd.DataFrame:
    """Чтение таблицы. """
    select_fields = [field for field in rules_fields if field != 'id']
    
    # Проверяем существование таблицы
    if not self.table_exists(table_name):
        print(f"Таблица {table_name} не существует")
        return pd.DataFrame()  # Возвращаем пустой DataFrame
    
    df_table = pd.read_sql(table_name, self.connection, index_col='id', columns=select_fields)
    df_table = self.apply_filters(df_table, filter_fields)
    
    if unique_fields:
        return df_table[unique_fields]
    return df_table

def table_exists(self, table_name):
    """Проверяет существование таблицы в БД."""
    try:
        query = f"SELECT 1 FROM {table_name} LIMIT 1"
        pd.read_sql(query, self.connection)
        return True
    except:
        return False
